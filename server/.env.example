# Listune Backend Configuration
PORT=8090

# Google SSO (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/auth/google/callback

# AcoustID (https://acoustid.org/new-application)
ACOUSTID_API_KEY=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:9000

# Optional: comma-separated allowlist of hosts the S3 proxy / tag writer may reach.
# When empty, only public hosts are reachable (link-local/cloud-metadata addresses
# are always blocked). Add local servers here, e.g.:
# S3_ALLOWED_HOSTS=s3.amazonaws.com,minio.local:9000
S3_ALLOWED_HOSTS=
