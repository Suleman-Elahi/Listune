# Listune Backend Configuration
PORT=8090

# Local library folder: songs live here (subfolders are scanned recursively).
# Soulseek downloads and YouTube MP3s (in the YouTube/ subfolder) are saved here as well.
LIBRARY_PATH=./data/library

# Soulseek bridge (Node script speaking NDJSON to slsk-client).
# SOULSEEK_BRIDGE=soulseek-bridge/bridge.mjs
# SOULSEEK_NODE=node
# Credentials come from the system keychain (soulseek login / UI login) or:
# SOULSEEK_ACCOUNT=
# SOULSEEK_PASSWORD=

# Google SSO (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/auth/google/callback
# YouTube search reuses this login. Enable "YouTube Data API v3" in the same
# Cloud project; sign-in requests the youtube.readonly scope and prompt for
# consent again so existing users grant it.

# Optional: path to an existing yt-dlp binary. When unset, go-ytdlp resolves
# yt-dlp from PATH or downloads it into its cache on first use. ffmpeg must be
# installed for MP3 conversion.
# YTDLP_BINARY=/usr/bin/yt-dlp

# AcoustID (https://acoustid.org/new-application)
ACOUSTID_API_KEY=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:9000

# Optional: comma-separated allowlist of hosts the S3 proxy / tag writer may reach.
# When empty, only public hosts are reachable (link-local/cloud-metadata addresses
# are always blocked). Add local servers here, e.g.:
# S3_ALLOWED_HOSTS=s3.amazonaws.com,minio.local:9000
S3_ALLOWED_HOSTS=
